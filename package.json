{
  "name": "marketplace-automacoes",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace brasileiro de automações desenvolvido com Spec-Driven Development.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:backend": "npm run start:dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:status": "docker compose ps",
    "infra:up": "docker compose up -d",
    "lint": "npm run lint --workspaces --if-present",
    "quality": "npm run format:check && npm run lint && npm run test:unit && npm run test:e2e && npm run build",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "packageManager": "npm@10.9.2"
}
