# Runtime local
NODE_ENV=development
PORT=3001
API_ORIGIN=http://127.0.0.1:3001
FRONTEND_ORIGIN=http://127.0.0.1:3000

# PostgreSQL local e Docker Compose
POSTGRES_DB=marketplace_automacoes
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_local
POSTGRES_PORT=5433
DATABASE_URL=postgresql://marketplace:marketplace_local@127.0.0.1:5433/marketplace_automacoes

# Mailpit e SMTP local
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
MAILPIT_MAX_MESSAGES=500
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=nao-responder@marketplace.local

# Segurança local — substitua o placeholder antes de iniciar a API
AUTH_HMAC_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=marketplace_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Durações em segundos
SESSION_ABSOLUTE_TTL=604800
SESSION_IDLE_TTL=86400
SESSION_ACTIVITY_TOUCH_INTERVAL=900
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=1800
EMAIL_RESEND_COOLDOWN=60
LOGIN_TEMP_BLOCK_MAX=900

# Limites
EMAIL_RESEND_MAX_PER_DAY=5
PASSWORD_RESET_MAX_PER_HOUR=5
LOGIN_PROGRESSIVE_DELAY_AFTER=5

# Versões legais vigentes
CURRENT_TERMS_VERSION=beta-1
CURRENT_PRIVACY_VERSION=beta-1

# Argon2id
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
